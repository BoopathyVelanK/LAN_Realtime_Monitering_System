# Copy to .env.local to override. See src/config.ts.

# Point at a real backend:
# VITE_API_BASE_URL=http://localhost:8080/api
# VITE_WS_URL=http://localhost:8080/api/ws
# VITE_USE_MOCKS=false

# Default: runs entirely against in-memory mock data + a simulated live feed,
# no backend required.
VITE_USE_MOCKS=true
